# ==============================================================================
# CACHE-AUGMENTED GENERATION (CAG) SALES ROLEPLAY SIMULATOR
# Environment Configuration
# ==============================================================================

# Provide your Google Gemini API Key below to activate live cloud KV Context Caching.
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively, GOOGLE_API_KEY can be used
# GOOGLE_API_KEY=your_google_api_key_here

# Model target (Default: gemini-1.5-flash-001)
# GEMINI_MODEL=gemini-1.5-flash-001

# KV Cache TTL in seconds (Default: 7200 -> 2 hours)
# CACHE_TTL_SECONDS=7200
